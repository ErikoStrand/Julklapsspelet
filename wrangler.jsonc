{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "julklappsspelet",
	"compatibility_date": "2026-11-02",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{ "pattern": "julklapp.party", "custom_domain": true },
		// redirected to the bare domain by a zone Redirect Rule
		{ "pattern": "www.julklapp.party", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "julklapp-eu",
			"database_id": "9e7af0ea-dc75-4a66-b7eb-b347e8b538f5",
			"migrations_dir": "migrations"
		}
	]
}
